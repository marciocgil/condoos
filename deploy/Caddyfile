# HTTPS for the CondoOS (Let's Encrypt, renewed by Caddy). Only the web is exposed; the API
# is reached through the web's /api rewrite on the internal network.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 25MB
	}
	reverse_proxy web:3000
}
