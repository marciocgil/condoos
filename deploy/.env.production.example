# Copy to deploy/.env.production ON THE SERVER only (never commit it): docs/deploy.md, 9.
# Passwords: letters and numbers only (they go inside database URLs). Generate each with
#   openssl rand -hex 24
APP_DOMAIN=app.condoos.ia.br
ACME_EMAIL=
POSTGRES_PASSWORD=
DB_APP_PASSWORD=
DB_WORKER_PASSWORD=

# Amazon SES (São Paulo): SMTP credentials of the IAM user created in the SES console.
SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CondoOS <nao-responda@condoos.ia.br>

# Documents (S3 São Paulo, private bucket) and the database backup (same bucket, backups/).
S3_BUCKET=condoos-documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Backup encryption passphrase (keep a copy in the password manager: without it a backup
# cannot be restored).
BACKUP_PASSPHRASE=

# Inbound e-mail (bucket written by SES, read by the worker).
INGEST_EMAIL_DOMAIN=entrada.condoos.ia.br
INBOUND_EMAIL_S3_BUCKET=condoos-entrada
INBOUND_EMAIL_S3_ACCESS_KEY_ID=
INBOUND_EMAIL_S3_SECRET_ACCESS_KEY=

# Optional: without it the system runs with recorded answers only (replay).
ANTHROPIC_API_KEY=
