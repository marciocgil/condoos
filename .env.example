# Copy to .env and adjust. Never commit .env. All values below are local-development defaults.

ENVIRONMENT=development

# PostgreSQL (owner) and the two application roles created by the migrations.
POSTGRES_PASSWORD=postgres
DB_APP_PASSWORD=condoos_app
DB_WORKER_PASSWORD=condoos_worker

# Load the fictitious seed (1 administradora, 2 condomínios, 12 meses) on API start.
SEED_ON_START=true

# Links sent by e-mail point here.
WEB_BASE_URL=http://localhost:3000

# S3-compatible storage (SeaweedFS locally). Presigned URLs use the public endpoint.
S3_BUCKET=condoos-documents
S3_ACCESS_KEY_ID=condoos
S3_SECRET_ACCESS_KEY=condoos-secret
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Anthropic (used from milestone 2 on). Leave empty to run with recorded responses only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_EXTRACTION=claude-sonnet-5-5
CLAUDE_MODEL_REASONING=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Host ports (change if something else already uses them).
POSTGRES_PORT=5432
S3_PORT=8333
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
API_PORT=8000
WEB_PORT=3000
