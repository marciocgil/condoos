# Copy to .env and adjust. Never commit .env. All values below are local-development defaults.

ENVIRONMENT=development

# PostgreSQL (owner) and the two application roles created by the migrations.
POSTGRES_PASSWORD=postgres
DB_APP_PASSWORD=condoos_app
DB_WORKER_PASSWORD=condoos_worker

# Load the fictitious seed (1 administradora, 2 condomínios, 12 meses) on API start.
SEED_ON_START=true

# Links sent by e-mail point here.
WEB_BASE_URL=http://localhost:3000

# S3-compatible storage (SeaweedFS locally). Presigned URLs use the public endpoint.
S3_BUCKET=condoos-documents
S3_ACCESS_KEY_ID=condoos
S3_SECRET_ACCESS_KEY=condoos-secret
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# Anthropic (used from milestone 2 on). Leave empty to run with recorded responses only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_EXTRACTION=claude-sonnet-5-5
CLAUDE_MODEL_REASONING=claude-opus-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Host ports (change if something else already uses them).
POSTGRES_PORT=5432
S3_PORT=8333
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
API_PORT=8000
WEB_PORT=3000

# LLM mode: live | record | replay | off (empty: live with a key, replay without).
LLM_MODE=
LLM_MONTHLY_BUDGET_USD_PER_CONDOMINIUM=40

# Chat "Pergunte ao CondoOS" (needs ANTHROPIC_API_KEY): limits per question.
CHAT_MAX_TURNS=8
CHAT_MAX_BUDGET_USD=0.50
# Local embedding model for document search (baked into the images). false = full text only.
EMBEDDINGS_ENABLED=true

# PDF/image -> text: auto (Docling when installed, the worker image has it) | docling | pdfium
DOCUMENT_CONVERTER=auto

# Inbound e-mail (D101): <slug>-<token>@INGEST_EMAIL_DOMAIN. Locally the worker reads .eml
# files from INBOUND_EMAIL_DIR. In production: INBOUND_EMAIL_PROVIDER=s3 and the bucket where
# Amazon SES (sa-east-1) stores the messages (docs/deploy.md, section 7). Production domain:
# INGEST_EMAIL_DOMAIN=entrada.condoos.ia.br
INGEST_EMAIL_DOMAIN=ingest.condoos.local
INBOUND_EMAIL_PROVIDER=none
INBOUND_EMAIL_S3_BUCKET=
INBOUND_EMAIL_S3_PREFIX=inbound/
INBOUND_EMAIL_S3_REGION=sa-east-1
INBOUND_EMAIL_S3_ACCESS_KEY_ID=
INBOUND_EMAIL_S3_SECRET_ACCESS_KEY=

# Outgoing e-mail: Mailpit locally. Through Amazon SES (docs/deploy.md, 7.1):
# SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=CondoOS <nao-responda@condoos.ia.br>
